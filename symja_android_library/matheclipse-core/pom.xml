		<dependency>
			<!-- CPD engine for DuplicateCodeTest; same PMD version as maven-pmd-plugin 3.21.2 -->
			<groupId>net.sourceforge.pmd</groupId>
			<artifactId>pmd-java</artifactId>
			<version>6.55.0</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<resources>
			<resource>
				<!-- Filter only the version.properties file -->
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<includes>
					<include>version.properties</include>
				</includes>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>false</filtering>
				<excludes>
					<exclude>version.properties</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<executions>
					<execution>
						<!-- WljsRegressionTest is written in Wolfram Language syntax, and that is
						decided before any Symja class is loaded: ParserConfig.PARSER_USE_LOWERCASE_SYMBOLS
						chooses whether the built-in symbol table is keyed "Join" or "join", and it is
						built once per JVM. So this one class gets a JVM of its own; the default
						execution below leaves it out. -->
						<id>wolfram-language-syntax</id>
						<phase>test</phase>
						<goals>
							<goal>test</goal>
						</goals>
						<configuration>
							<!-- -Dtest overrides <includes>: without this the classes a targeted run asks for
							ran a second time here, the slow tests included -->
							<test>WljsRegressionTest</test>
							<includes>
								<include>**/WljsRegressionTest.java</include>
							</includes>
							<excludes combine.self="override" />
							<groups combine.self="override" />
							<excludedGroups combine.self="override" />
						</configuration>
					</execution>
					<execution>
						<id>default-test</id>
						<configuration>
							<excludes>
								<exclude>**/WljsRegressionTest.java</exclude>
							</excludes>
							<!-- -Dtest overrides <excludes> but not the excluded groups: the tag keeps
							WljsRegressionTest out of this JVM in a targeted run too -->
							<excludedGroups>wolfram-language-syntax,${symja.test.excludedGroups}</excludedGroups>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- static analysis; settings in the parent pom, spotbugs-exclude.xml lists the
				patterns which are intended, with the reason. On demand:
				mvn -o test-compile spotbugs:check -pl matheclipse-core
				The "spotbugs" profile below binds the check to the build; the PR workflow runs it. -->
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<!-- Duplicate code check (CPD) in the verify phase; defaults in the parent pom.
				Generated sources (Rubi IntRules, rules/*Rules, the ID/S/J symbol tables) are excluded;
				keep this list in sync with DuplicateCodeTest. Deliberate copies are wrapped in // CPD-OFF ... // CPD-ON.
				Report: target/cpd.xml. Skip with -Dcpd.skip=true -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>**/core/integrate/rubi/**</exclude>
						<exclude>**/core/reflection/system/rules/**</exclude>
						<exclude>**/core/expression/ID.java</exclude>
						<exclude>**/core/expression/S.java</exclude>
						<exclude>**/core/expression/J.java</exclude>
						<exclude>**/core/data/ElementData1.java</exclude>
						<exclude>**/core/data/ElementData2.java</exclude>
					</excludes>
					<maxAllowedViolations>${cpd.maxAllowedViolations}</maxAllowedViolations>
				</configuration>
				<executions>
					<execution>
						<id>cpd-check</id>
						<goals>
							<goal>cpd-check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- SpotBugs check of the main and test classes, opt-in; settings in the parent pom:
		mvn -Pspotbugs process-test-classes -pl matheclipse-core -am -->
		<profile>
			<id>spotbugs</id>
			<build>
				<plugins>
					<plugin>
						<groupId>com.github.spotbugs</groupId>
						<artifactId>spotbugs-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>spotbugs-check</id>
								<phase>process-test-classes</phase>
								<goals>
									<goal>check</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>