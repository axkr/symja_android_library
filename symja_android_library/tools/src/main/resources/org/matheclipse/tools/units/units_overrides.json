  "patch": {
    "$comment-patch": "WMA/SI-convention corrections: pint bases fathom/rod/acre on the deprecated US survey foot (WL uses international feet), computes parsec via the tansec decimal (WL/IAU: exact 648000/Pi au), and defines gauss/maxwell/oersted in the non-SI-commensurate Gaussian-CGS system (WL uses the SI-equivalent values).",
    "Fathoms": { "coefficient": "1143/625" },
    "Rods": { "coefficient": "12573/2500" },
    "Acres": { "coefficient": "316160658/78125" },
    "Parsecs": { "coefficient": "96939420213600000*Pi^(-1)" },
    "Gauss": {
      "coefficient": "1/10000",
      "factors": { "Kilograms": 1, "Seconds": -2, "Amperes": -1 }
    },
    "Maxwells": {
      "coefficient": "1/100000000",
      "factors": { "Kilograms": 1, "Meters": 2, "Seconds": -2, "Amperes": -1 }
    },
    "Oersteds": {
      "coefficient": "250*Pi^(-1)",
      "factors": { "Amperes": 1, "Meters": -1 }
    }
  },
  "add": [
    {
      "name": "USDollars",
      "coefficient": "1",
      "factors": { "USDollars": 1 },
      "abbrev": "$",
      "prefixable": false,
      "aliases": ["USD", "us_dollar", "dollar"]
    },
    {
      "name": "DegreesCelsiusDifference",
      "coefficient": "1",
      "factors": { "Kelvins": 1 },
      "temperature": "difference",
      "prefixable": false,
      "aliases": []
    },
    {
      "name": "DegreesFahrenheitDifference",
      "coefficient": "5/9",
      "factors": { "Kelvins": 1 },
      "temperature": "difference",
      "prefixable": false,
      "aliases": []
    },
    {
      "name": "PureUnities",
      "coefficient": "1",
      "factors": {},
      "prefixable": false,
      "aliases": []
    },
    {
      "name": "DimensionlessUnit",
      "coefficient": "1",
      "factors": {},
      "prefixable": false,
      "aliases": []
    },
    {
      "name": "Months",
      "coefficient": "2629746",
      "factors": { "Seconds": 1 },
      "prefixable": false,
      "aliases": ["month"]
    }
  ],
  "aliases": {
    "Kelvins": ["KelvinsDifference"]
  },
  "removeAliases": {
    "$comment-removeAliases": "pint's canonical 'year' is the Julian year (365.25 d), but legacy Symja si.properties and WMA both use the Gregorian year (31556952 s) for plain 'year' - freeing the alias here lets the si.properties import attach it to 'Years' (Gregorian).",
    "JulianYears": ["year"]
  }
}
