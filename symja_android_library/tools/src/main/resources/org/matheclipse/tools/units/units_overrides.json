{
  "$comment": "Hand-curated input for UnitsJsonGenerator. 'names' maps pint canonical names to confirmed WMA canonical unit names (everything unmapped gets an auto-generated name and 'provisional': true in units.json). 'skip' = do not resolve or emit; 'noEmit' = resolvable internally (constants needed by other definitions) but not emitted as units; 'forceBase' overrides a pint definition to be a Symja base unit; 'add' appends/replaces entries wholesale (used for WL-only units); 'patch' edits fields of generated entries by WL name; 'aliases' appends aliases by WL name.",
  "skip": ["pixel"],
  "noEmit": ["pi", "tansec", "ln10", "wien_x", "wien_u", "eulers_number", "zeta", "electron_g_factor", "count", "refractive_index_unit", "absorbance_unit"],
  "forceBase": { "steradian": "Steradians" },
  "skipPrefixes": ["semi", "sesqui"],
  "prefixNames": { "deca": "Deka" },
  "names": {
    "meter": "Meters",
    "second": "Seconds",
    "ampere": "Amperes",
    "candela": "Candelas",
