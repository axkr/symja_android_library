<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.matheclipse</groupId>
		<artifactId>matheclipse</artifactId>
		<version>3.3.0-SNAPSHOT</version>
	</parent>

	<artifactId>matheclipse-jsgraphics</artifactId>
	<packaging>jar</packaging>
	<name>${project.groupId}:${project.artifactId}</name>
	<description>The Symja JavaScript graphics module: renders Graphics with the
		JSXGraph, Apache ECharts and MathCell JavaScript libraries, in an iframe
		that loads the library from a CDN</description>

	<licenses>
		<license>
			<name>GNU Lesser General Public License, Version 2.1</name>
			<url>https://www.gnu.org/licenses/old-licenses/lgpl-2.1.html</url>
			<distribution>repo</distribution>
			<comments>A free, copyleft license for software and other kinds of works</comments>
		</license>
	</licenses>

	<!-- No maven.compiler.release override: the module generates strings only
	and inherits the release 11 default of the parent POM. -->

	<dependencies>

		<!-- The JavaScript libraries themselves are not dependencies: the pages
		this module builds load them from a CDN inside the browser. So there are
		no third-party jars here, and matheclipse-core must not depend on this
		module, which org.matheclipse.io.archunit.JSGraphicsDependencyTest
		asserts. -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>matheclipse-core</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- logging dependencies -->

		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>matheclipse-logging</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- test dependencies -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>matheclipse-script</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>

	</dependencies>

</project>
