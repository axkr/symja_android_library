<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.matheclipse</groupId>
		<artifactId>matheclipse</artifactId>
		<version>3.3.0-SNAPSHOT</version>
	</parent>

	<artifactId>matheclipse-external</artifactId>
	<packaging>jar</packaging>
	<name>${project.groupId}:${project.artifactId}</name>
	<description>The Symja external module</description>

	<licenses>
		<license>
			<name>GNU Lesser General Public License, Version 3</name>
			<url>https://www.gnu.org/licenses/lgpl-3.0.html</url>
			<distribution>repo</distribution>
			<comments>A free, copyleft license for software and other kinds of
				works</comments>
		</license>
	</licenses>

	<dependencies>

		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-api</artifactId>
		</dependency>
		<dependency>
			<!-- org.matheclipse.external.apfloat holds functions written against the public
				apfloat API, in apfloat's conventions, so that they can be contributed to apfloat -->
			<groupId>org.apfloat</groupId>
			<artifactId>apfloat</artifactId>
		</dependency>
		
		<!-- test dependencies -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>matheclipse-logging</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<!-- only used to differential-test the slim replacements in
				org.matheclipse.external.fastutil against the original implementation -->
			<groupId>it.unimi.dsi</groupId>
			<artifactId>fastutil-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>

			<plugin>
				<groupId>biz.aQute.bnd</groupId>
				<artifactId>bnd-maven-plugin</artifactId>
				<configuration>
					<bnd><![CDATA[
						Import-Package: !net.sf.saxon,*
					]]></bnd>
				</configuration>
			</plugin>
			<plugin>
				<!-- static analysis; settings in the parent pom, spotbugs-exclude.xml lists the
				patterns which are intended, with the reason. On demand:
				mvn -o test-compile spotbugs:check -pl matheclipse-external -->
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
			</plugin>

		</plugins>
	</build>

	<profiles>
		<!-- SpotBugs check of the main and test classes, opt-in; settings in the parent pom:
		mvn -Pspotbugs process-test-classes -pl matheclipse-external -am -->
		<profile>
			<id>spotbugs</id>
			<build>
				<plugins>
					<plugin>
						<groupId>com.github.spotbugs</groupId>
						<artifactId>spotbugs-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>spotbugs-check</id>
								<phase>process-test-classes</phase>
								<goals>
									<goal>check</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
