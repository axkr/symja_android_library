# ProGuard rules for the notebook kernel's jar set (target/notebook/jars -> target/notebook/jars-min).
#
# Why: on a static host the browser downloads every kernel jar whole before the first evaluation,
# so every class that is never used is paid for on every cold start. ProGuard removes unused
# classes and members from all jars and renames the classes of the third-party libraries. Symja's
# own classes keep their names: builtins are nested classes whose names show up in messages and
# documentation links, and Compile writes Java source that names them.
#
# The -injars/-outjars pairs (one output jar per input jar, so classpath.txt, the per-library
# browser cache and each jar's own META-INF/services files stay as they are) and the
# -libraryjars of the JDK are generated by the build into target/proguard/jars.pro, with absolute
# paths (ProGuard resolves a relative path against the directory of the file that names it), and
# so are -printmapping, -printusage and -printseeds (into target/proguard/).
#
# A class or member reached only by name (Class.forName, reflection, service files, log4j plugins,
# source compiled at run time) is invisible to ProGuard's reachability analysis and needs a rule
# here. ProGuard itself already keeps constant-string Class.forName, getField/getMethod and
# Atomic*FieldUpdater.newUpdater targets; the rules below name them anyway, as documentation.

-dontoptimize
# No -dontpreverify: class files of version 50+ must carry StackMapTable frames, and without
# preverification ProGuard writes them without (VerifyError "Expecting a stackmap frame").
# Preverification keeps each class's version, so CheerpJ's limit of 61 still holds.
-keepattributes Signature,*Annotation*,InnerClasses,EnclosingMethod,Exceptions,SourceFile,LineNumberTable,MethodParameters
-renamesourcefileattribute SourceFile
# Rename classes but not packages: libraries that load resources relative to their package keep
# working, and the saving of shorter package names is small.
-keeppackagenames **
-adaptresourcefilecontents META-INF/services/**

# ------------------------------------------------------------------------------------------------
# Entry points
# ------------------------------------------------------------------------------------------------

# The notebook page's worker calls these static methods by name through CheerpJ's library mode
# (kernel-config.js kernelClass).
-keep public class org.matheclipse.web.NotebookKernel { public static *; }
# spike.html calls init/eval/benchmarkInputs/selfTestNames/selfTest; main is the desktop baseline.
-keep public class org.matheclipse.web.SymjaCheerpJ { public static *; }

# BrowserNotebook answers the page's /ajax/* requests through the servlets' own doGet/doPost.
-keep class org.matheclipse.io.servlet.** extends jakarta.servlet.http.HttpServlet { *; }
# ... with java.lang.reflect.Proxy stand-ins for these interfaces, dispatched on Method.getName().
-keep interface jakarta.servlet.** { *; }

# ------------------------------------------------------------------------------------------------
# Names: Symja's own jars and the libraries that are reflection all the way down keep their names
# ------------------------------------------------------------------------------------------------

# The matheclipse-* jars (matheclipse-external vendors edu.jas, SnuggleTeX and a few more).
-keepnames class org.matheclipse.**, edu.jas.**, uk.ac.ed.**, io.github.mangara.**, com.baeldung.** { *; }
-keepnames class com.fasterxml.jackson.** { *; }

# ------------------------------------------------------------------------------------------------
# Symja: code reached by name
# ------------------------------------------------------------------------------------------------

# BuiltInSymbol loads "org.matheclipse.core.reflection.system.rules." + X + "Rules" by name
# (registered in AutomaticRules); only the static initializer runs.
-keep class org.matheclipse.core.reflection.system.rules.*Rules { static <fields>; static <methods>; }

# IOInit loads the optional OR-Tools module by name; nlp, astro, bio, chem and dataset are
# referenced directly but are not part of the browser's jar set (IOInit catches the error).
-dontwarn org.matheclipse.ortools.**
-dontwarn org.matheclipse.nlp.**
-dontwarn org.matheclipse.astro.**
-dontwarn org.matheclipse.bio.**
-dontwarn org.matheclipse.chem.**
-dontwarn org.matheclipse.dataset.**

# Compile: the generated Java source is compiled at run time by Janino, which resolves the names it
# uses by reflection over the loaded classes. The source can name any F/S member (heads, constants,
# patterns of the compiled expression) and the API below, so all of it must survive shrinking.
-keep class org.matheclipse.core.expression.F { public static *; }
-keep class org.matheclipse.core.expression.S { public static *; }
-keep class org.matheclipse.core.expression.CMath { public static *; }
-keep class org.matheclipse.core.expression.DMath { public static *; }
-keep class org.matheclipse.core.expression.ExprTrie { public *; }
-keep class org.matheclipse.core.eval.EvalEngine { public *; }
-keep interface org.matheclipse.core.interfaces.IExpr { public *; }
-keep interface org.matheclipse.core.interfaces.IAST { public *; }
-keep interface org.matheclipse.core.interfaces.IASTAppendable { public *; }
-keep interface org.matheclipse.core.interfaces.ISymbol { public *; }
-keep class org.matheclipse.core.eval.interfaces.AbstractFunctionEvaluator { public protected *; }
-keep interface org.matheclipse.core.eval.interfaces.IFunctionEvaluator { *; }
-keep class org.matheclipse.core.eval.exception.BreakException { public *; }
-keep class org.matheclipse.core.eval.exception.ContinueException { public *; }
-keep class org.matheclipse.core.eval.exception.ReturnException { public *; }
-keep class org.matheclipse.core.eval.exception.ArgumentTypeException { public <init>(java.lang.String); }
-keep class org.matheclipse.compile.expression.CompiledFunctionExpr { public static *; }
-keep class org.hipparchus.complex.Complex { public *; }
# Janino and commons-compiler: a compiler working on reflection, kept whole.
-keep class org.codehaus.** { *; }

# BDDExpr reads private members of logicng's BDD kernel reflectively.
-keepclassmembers class org.logicng.knowledgecompilation.bdds.jbuddy.BDDKernel {
  int level(int);
  int high(int);
  int low(int);
  int[] level2var;
}

# AtomicIntegerFieldUpdater by field name.
-keepclassmembers class org.matheclipse.core.patternmatching.IPatternMatcher { volatile int fInUse; }
-keepclassmembers class org.matheclipse.core.patternmatching.RulesData { volatile int fRuleIndexEpoch; }

# JGraphT edge suppliers create edges with getDeclaredConstructor().newInstance().
-keep class org.matheclipse.graphtheory.expression.data.ExprEdge { <init>(); }
-keep class org.matheclipse.graphtheory.expression.data.ExprWeightedEdge { <init>(); }
-keep class org.jgrapht.graph.DefaultEdge { <init>(); }
-keep class org.jgrapht.graph.DefaultWeightedEdge { <init>(); }

# JAS asks a coefficient for bitLength() through getMethod.
-keepclassmembers class * implements edu.jas.structure.RingElem { public long bitLength(); }

# Deliberately NOT kept: Java serialization members (readObject/readResolve/writeReplace...) and
# Kryo's reflectasm. The kernel never deserializes: the only ObjectInputStream readers
# (AbstractFunctionEvaluator /ser/*.ser, BinomialCache /bin/*) read resources that are not shipped,
# BinarySerialize uses WXF, and Kryo is reached only from KryoUtil.main. matheclipse-core's
# SerializableTest, FormalSymbolTest (serialization cases) and RulesDataSerializationTest are the
# only fast-tier tests that fail on the shrunk jars, for this reason.

# Enum.valueOf with user text (ColorData gradients and lists), EnumMap/EnumSet.
-keepclassmembers enum * {
  public static **[] values();
  public static ** valueOf(java.lang.String);
}

# ------------------------------------------------------------------------------------------------
# Third-party libraries: service files, plugins, reflection
# ------------------------------------------------------------------------------------------------

# log4j: configuration, plugins (Log4j2Plugins.dat), providers and property sources are all found
# by name. BrowserLogging names Console, PatternLayout and ThresholdFilter; SymjaCheerpJ names the
# SimpleLoggerContextFactory. Kept whole.
-keep class org.apache.logging.** { *; }
-keep class org.slf4j.** { *; }
# matheclipse-logging's appender, listed in its own Log4j2Plugins.dat as "ThreadLocalNotifier".
-keep class org.matheclipse.logging.** { *; }
-dontwarn org.apache.logging.**
-dontwarn org.slf4j.**

# Service implementations (META-INF/services of the jar set).
-keep class org.apfloat.internal.*BuilderFactory { <init>(); }
-keep class com.fasterxml.jackson.core.JsonFactory { <init>(); }
-keep class com.fasterxml.jackson.databind.ObjectMapper { <init>(); }

# Guava picks its atomic helpers (VarHandle, then Unsafe, then field updaters) by field name and
# falls back silently, so renamed fields would only cost speed; keeping the names is free.
-keepclassmembernames class com.google.common.** { <fields>; }
# hipparchus' linear optimizer restores its "coefficients" field reflectively.
-keepclassmembernames class org.hipparchus.optim.linear.** { <fields>; }

# Jackson: annotation-driven introspection of its own classes.
-keep class com.fasterxml.jackson.annotation.** { *; }
-keepclassmembers class com.fasterxml.jackson.** {
  @com.fasterxml.jackson.annotation.* *;
}
-dontwarn com.fasterxml.jackson.**

# Optional dependencies that are not on the browser's class path (compile-time annotations, OSGi
# metadata, optional caches and formats). Each was checked to be referenced only from code the
# kernel does not run, or to be an annotation.
# - Undertow/XNIO: matheclipse-io's UndertowLauncher (the desktop server), compiled in with the io
#   sources but never started in the browser.
-dontwarn io.undertow.**
-dontwarn org.xnio.**
# - Ant: Janino's AntCompilerAdapter (an Ant task).
-dontwarn org.apache.tools.ant.**
-dontwarn org.codehaus.janino.AntCompilerAdapter
# - Lombok @Generated in boofcv, ddogleg and ejml; OSGi/bnd annotations in jsvg; SpotBugs
#   annotations in commons and core.
-dontwarn lombok.**
-dontwarn org.osgi.**
-dontwarn aQute.bnd.**
-dontwarn edu.umd.cs.findbugs.**
# - Pebble's optional Caffeine cache and servlet loader; ejml's optional MATLAB file support.
-dontwarn com.github.benmanes.caffeine.**
-dontwarn javax.servlet.**
-dontwarn us.hebi.matlab.**
# - Signature-polymorphic MethodHandle.invoke*/VarHandle calls (guava, jsvg) that ProGuard
#   reports as missing library members; they resolve at run time.
-dontwarn java.lang.invoke.MethodHandle
-dontwarn java.lang.invoke.VarHandle
-dontwarn javax.annotation.**
-dontwarn org.checkerframework.**
-dontwarn com.google.errorprone.**
-dontwarn com.google.j2objc.**
-dontwarn org.jspecify.**
-dontwarn sun.misc.**
-dontwarn kotlin.**
