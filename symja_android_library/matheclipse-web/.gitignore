# Cloudflare credentials (CF_DOMAIN, CF_ACCOUNT_ID, CF_WORKER_TOKEN) used by
# tools/deploy-cloudflare.sh. Must never be committed. Optional: on macOS the script
# reads them from the login Keychain when this file is missing.
.env

# Build output (jars, assembled site) is regenerated by maven and tools/deploy-cloudflare.sh.
target/
